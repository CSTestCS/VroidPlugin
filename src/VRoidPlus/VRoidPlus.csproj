<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Two build modes:
      * Real build (what the installer does): pass -p:GameDir="C:\...\VRoid Studio".
        Compiles against the IL2CPP interop assemblies BepInEx generated for the
        user's own copy of VRoid Studio. Defines IL2CPP.
      * Check build (no GameDir): compiles against public Unity/BepInEx reference
        packages so the code can be syntax/type checked without the game.
        The output of this mode is NOT a working plugin.
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>VRoidPlus</AssemblyName>
    <RootNamespace>VRoidPlus</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <NoWarn>$(NoWarn);CS0618;CS0436;MSB3277;MSB3243</NoWarn>
    <Version>0.1.1</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GameDir)' != ''">
    <DefineConstants>$(DefineConstants);IL2CPP</DefineConstants>
    <DefineConstants Condition="Exists('$(GameDir)\BepInEx\interop\UnityEngine.UI.dll')">$(DefineConstants);HAS_UGUI</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(GameDir)' != ''">
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.Common.dll" Private="false" Condition="Exists('$(GameDir)\BepInEx\core\BepInEx.Unity.Common.dll')" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Common.dll" Private="false" Condition="Exists('$(GameDir)\BepInEx\core\Il2CppInterop.Common.dll')" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll" Private="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(GameDir)' == ''">
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.793" IncludeAssets="compile" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.62" IncludeAssets="compile" />
  </ItemGroup>
</Project>
